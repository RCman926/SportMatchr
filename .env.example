# Copy to .env — never commit real keys
# SportMatchr has its OWN Supabase project (not HealthDNA).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional: comma-separated emails that can seed sessions / see founder ops UI
EXPO_PUBLIC_FOUNDER_EMAILS=you@email.com
